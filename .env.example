# 仅作模板；已有.env请保留真实连接与密钥，不要直接覆盖。
DATABASE_URL=mysql+pymysql://research_app:YOUR_PASSWORD@127.0.0.1:3306/research_library?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
DEEPSEEK_API_KEY=

CELERY_QUEUE=report_jobs
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_TIMEOUT=120
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=300
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_JSON_MAX_TOKENS=8192
UPLOAD_DIR=uploads/papers
MAX_UPLOAD_MB=20
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info
LOG_DIR=logs
HEALTH_TIMEOUT=2
